<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2660 \u0414\u0443\u0440\u0430\u043a \u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u041e\u0432\u0435\u0440\u043b\u0435\u0439 \u043f\u043e\u0432\u0435\u0440\u0445 \u0438\u0433\u0440\u044b + AI \u0441\u043e\u0432\u0435\u0442\u044b"
            android:textColor="#C8E6C9"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Настройки игры -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u041d\u0410\u0421\u0422\u0420\u041e\u0419\u041a\u0418 \u0418\u0413\u0420\u042b"
            android:textColor="#A5D6A7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u0418\u0433\u0440\u043e\u043a\u0438:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerPlayers"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u041a\u043e\u0437\u044b\u0440\u044c:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerTrump"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u2660"
            android:textSize="17sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnStopOverlay"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043e\u0432\u0435\u0440\u043b\u0435\u0439"
            android:textSize="13sp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- GigaChat API -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GIGACHAT API (\u043e\u043f\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e)"
            android:textColor="#CE93D8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u0412\u0441\u0442\u0430\u0432\u044c\u0442\u0435 Base64 \u043a\u043b\u044e\u0447 (ClientID:Secret \u0432 \u043e\u0434\u043d\u0443 \u0441\u0442\u0440\u043e\u043a\u0443).\n\u0411\u0435\u0437 \u043d\u0435\u0433\u043e \u0442\u0440\u0435\u043a\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043e\u0444\u043b\u0430\u0439\u043d, \u043d\u043e \u043a\u043d\u043e\u043f\u043a\u0430 AI \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430."
            android:textColor="#B0BEC5"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Base64 ключ (ClientID:Secret)"
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C"
            android:textSize="12sp"
            android:background="#33FFFFFF"
            android:padding="10dp"
            android:singleLine="true"
            android:inputType="text"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnSaveApi"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c API \u043a\u043b\u044e\u0447"
            android:textSize="13sp"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvApiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Профиль промпта -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u041f\u0420\u041e\u0424\u0418\u041b\u042c \u041f\u0420\u041e\u041c\u041f\u0422\u0410 AI"
            android:textColor="#CE93D8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0438\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0441\u0432\u043e\u0439. \u041f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435:\n{trump} {my_cards} {my_count} {table}\n{discarded} {discard_count} {unknown}\n{unknown_count} {my_trumps} {opp_trumps} {deck}"
            android:textColor="#B0BEC5"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerPromptProfile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPromptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="8"
            android:hint="\u0422\u0435\u043a\u0441\u0442 \u043f\u0440\u043e\u043c\u043f\u0442\u0430..."
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C"
            android:textSize="12sp"
            android:background="#33FFFFFF"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnSavePrompt"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c"
                android:textSize="12sp"
                android:backgroundTint="#6A1B9A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnDeletePrompt"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="\u0423\u0434\u0430\u043b\u0438\u0442\u044c"
                android:textSize="12sp"
                android:backgroundTint="#C62828"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNewProfileName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="\u0418\u043c\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u044f"
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C"
            android:textSize="12sp"
            android:background="#33FFFFFF"
            android:padding="10dp"
            android:singleLine="true"
            android:inputType="text"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnAddProfile"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u0440\u043e\u0444\u0438\u043b\u044c"
            android:textSize="12sp"
            android:backgroundTint="#4527A0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Инструкция -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u041a\u0430\u043a \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f:\n1. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0438 \u043a\u043e\u0437\u044b\u0440\u044c\n2. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u00bb\n3. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0438\u0433\u0440\u0443, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u2660\n4. \u041e\u0442\u043c\u0435\u0447\u0430\u0439\u0442\u0435 \u043a\u0430\u0440\u0442\u044b: \u041c\u043e\u0438 / \u0421\u0442\u043e\u043b / \u0411\u0438\u0442\u043e\n5. \u00ab\u2192 \u0411\u0438\u0442\u043e\u00bb \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u0431\u043e\u044f\n6. \u00ab\u0417\u0430\u0431\u0440\u0430\u043b\u0438\u00bb \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0432\u0437\u044f\u043b\n7. \u00abAI \u0441\u043e\u0432\u0435\u0442\u00bb \u2014 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0443 \u043e\u0442 GigaChat"
            android:textColor="#A5D6A7"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
