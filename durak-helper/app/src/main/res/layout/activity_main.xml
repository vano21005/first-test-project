<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2660 \u0414\u0443\u0440\u0430\u043a \u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u041e\u0432\u0435\u0440\u043b\u0435\u0439 \u043f\u043e\u0432\u0435\u0440\u0445 \u0438\u0433\u0440\u044b \u2022 \u0431\u0435\u0437 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0430"
            android:textColor="#C8E6C9"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438\u0433\u0440\u043e\u043a\u043e\u0432:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerPlayers"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u041a\u043e\u0437\u044b\u0440\u043d\u0430\u044f \u043c\u0430\u0441\u0442\u044c:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerTrump"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u2660"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopOverlay"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043e\u0432\u0435\u0440\u043b\u0435\u0439"
            android:textSize="14sp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435"
            android:textColor="#FFD54F"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\u041a\u0430\u043a \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f:\n1. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0447\u0438\u0441\u043b\u043e \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0438 \u043a\u043e\u0437\u044b\u0440\u044c\n2. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u00bb\n3. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0438\u0433\u0440\u0443 \u00ab\u0414\u0443\u0440\u0430\u043a \u043e\u043d\u043b\u0430\u0439\u043d\u00bb\n4. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u2660 \u2014 \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0441\u044f \u043f\u0430\u043d\u0435\u043b\u044c\n5. \u0420\u0435\u0436\u0438\u043c \u00ab\u041c\u043e\u0438\u00bb \u2014 \u043e\u0442\u043c\u0435\u0442\u044c\u0442\u0435 \u0441\u0432\u043e\u0438 \u043a\u0430\u0440\u0442\u044b\n6. \u0420\u0435\u0436\u0438\u043c \u00ab\u0421\u0442\u043e\u043b\u00bb \u2014 \u043a\u0430\u0440\u0442\u044b \u043d\u0430 \u0441\u0442\u043e\u043b\u0435\n7. \u00ab\u2192 \u0411\u0438\u0442\u043e\u00bb \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u0431\u043e\u044f\n8. \u00ab\u0417\u0430\u0431\u0440\u0430\u043b\u0438\u00bb \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0432\u0437\u044f\u043b\n\n\u041f\u0430\u043d\u0435\u043b\u044c \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442:\n\u2022 \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f \u043a\u0430\u0440\u0442\u044b \u0438 \u043a\u043e\u0437\u044b\u0440\u0438\n\u2022 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438 \u043f\u043e \u0445\u043e\u0434\u0443 \u0438\u0433\u0440\u044b\n\u2022 \u0432\u0441\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0431\u0435\u0437 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0430"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
