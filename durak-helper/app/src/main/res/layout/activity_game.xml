<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Козырь и статистика -->
        <TextView
            android:id="@+id/tvTrump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Козырь: "
            android:textColor="#FFD54F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статистика"
            android:textColor="#C8E6C9"
            android:textSize="13sp"
            android:padding="8dp"
            android:background="#2E7D32"
            android:layout_marginBottom="4dp" />

        <!-- Мои карты -->
        <TextView
            android:id="@+id/tvMyCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мои карты: —"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#388E3C"
            android:layout_marginBottom="2dp" />

        <!-- Карты на столе -->
        <TextView
            android:id="@+id/tvTableCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="На столе: —"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#F57F17"
            android:layout_marginBottom="4dp" />

        <!-- Режимы ввода -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnModeMyCards"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Мои карты"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnModeTable"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="На стол"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Сетка карт 36 шт -->
        <GridLayout
            android:id="@+id/gridCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="9"
            android:layout_marginBottom="4dp" />

        <!-- Действия -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnDiscard"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Бито"
                android:textSize="12sp"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnTakeCards"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Забрали"
                android:textSize="12sp"
                android:backgroundTint="#5D4037"
                android:textColor="#FFFFFF"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Сброс"
                android:textSize="12sp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Подсказка (встроенная логика) -->
        <TextView
            android:id="@+id/tvAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подсказка появится здесь"
            android:textColor="#FFD54F"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#33691E"
            android:layout_marginBottom="4dp" />

        <!-- AI-совет -->
        <Button
            android:id="@+id/btnAiAdvice"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Спросить AI"
            android:textSize="13sp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAiAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CE93D8"
            android:textSize="13sp"
            android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
